# Model presets for the same repo:
# Fast test:      UD-Q3_K_M
# Smaller/faster: UD-IQ3_S
# Smallest test:  UD-IQ2_M
# Balanced:       UD-Q4_K_M
# Better quality: UD-Q5_K_S
# 6-bit quality:  UD-Q6_K
# 6-bit quality:  UD-6_K_XL
LLAMA_CPP_HF_SELECTOR=UD-Q6_K_XL
