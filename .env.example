PRICE_TAG_DATA_DIR=./data
PRICE_TAG_API_PIPELINE_ARGS=--detector onnx --frame-step 3 --run-ocr
PRICE_TAG_OCR_BASE_URL=http://llama-cpp:8080/v1
PRICE_TAG_OCR_API_KEY=not-needed
PRICE_TAG_OCR_MODEL=local-vlm
PRICE_TAG_OCR_MAX_TOKENS=900
PRICE_TAG_OCR_TEMPERATURE=0.0
PRICE_TAG_OCR_TIMEOUT=180.0
PRICE_TAG_OCR_RETRIES=1
PRICE_TAG_OCR_RESPONSE_FORMAT=false
PRICE_TAG_OCR_DISABLE_REASONING=true

LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_CPP_PORT=18080
LLAMA_CPP_BASE_URL=http://llama-cpp:8080/v1
LLAMA_CPP_MODEL=local-vlm
LLAMA_CPP_HF_MODEL=unsloth/NVIDIA-Nemotron-3-Nano-Omni-30B-A3B-Reasoning-GGUF
# Model presets for the same repo:
# Fast test:      UD-Q3_K_M
# Smaller/faster: UD-IQ3_S
# Smallest test:  UD-IQ2_M
# Balanced:       UD-Q4_K_M
# Better quality: UD-Q5_K_S
LLAMA_CPP_HF_SELECTOR=UD-Q3_K_M
LLAMA_CPP_CTX_SIZE=8192
LLAMA_CPP_N_GPU_LAYERS=28
LLAMA_CPP_PARALLEL=1
LLAMA_CPP_MAX_TOKENS=700
LLAMA_CPP_TEMPERATURE=0.0
LLAMA_CPP_TIMEOUT=180.0
LLAMA_CPP_RETRIES=1
LLAMA_CPP_RESPONSE_FORMAT=false
HF_TOKEN=
